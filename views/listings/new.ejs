<% layout("/layouts/boilerplate");%>


<div class="row mt-3">
    <div class="col-md-8 offset-2"></div>
    
    <h3>Create New Listing:</h3>

    <form action="/listings" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">

        <div class="mb-3">
            <label class="form-label">Enter the Title</label>
            <input type="text" name="listing[title]" class="form-control" placeholder="Enter your Title" required>
            <div class="valid-feedback">Title looks good</div>
        </div>
        

        <div class="mb-3">
            <label class="form-label">Enter Description</label>
            <textarea name="listing[description]" class="form-control" placeholder="Enter description" required></textarea>
             <div class="invalid-feedback">Please enter a short description</div>
        </div>

        <div class="mb-3">
            <label class="form-label">Upload Image</label>
            <input type="file" name="listing[image]" class="form-control" >
        </div>
        <div class="row">
            <div class="mb-3 col-md-4">
                <label class="form-label">Enter Price</label>
                <input  name="listing[price]" class="form-control" placeholder="Enter the Price" required>
                 <div class="invalid-feedback">Price should be valid</div>
            </div>
            <div class="mb-3 col-md-8">
                <label class="form-label">Enter Country</label>
                <input type="text" name="listing[country]" class="form-control" placeholder="Enter the country Name"required>
                 <div class="invalid-feedback">Country should be valid</div>
            </div>
        </div>

        

        <div class="mb-3">
            <label class="form-label">Enter Location</label>
            <input type="text" name="listing[location]" class="form-control" placeholder="Enter the location" required>
            <div class="invalid-feedback">Location should be valid</div>
            </div>
        </div>

        

        <button type="submit" class="btn btn-dark add-btn mt-3">Add</button>
        
        

    </form>
    
</div>

    



